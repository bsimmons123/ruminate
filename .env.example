# Create an API application at https://api.esv.org/ and paste its token here.
ESV_API_KEY=

# Self-hosted PostgreSQL and session configuration.
POSTGRES_PASSWORD=choose-a-strong-database-password
JWT_SECRET=generate-a-long-random-secret
COOKIE_SECURE=false

# Required for Android push delivery: mount a Firebase service account JSON file
# and set GOOGLE_APPLICATION_CREDENTIALS to its path (or use FIREBASE_SERVICE_ACCOUNT_JSON).
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Required for iOS push delivery: Apple APNs auth key, team/key IDs, and app bundle ID.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.selah.scripturememory
APNS_SANDBOX=false
